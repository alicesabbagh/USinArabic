    </main>

    <!-- Footer / Navigation -->
    <footer class="p-8 border-t border-white/5">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <button id="prev" class="nav-btn px-6 py-3 rounded-full bg-gray-800 text-sm font-bold hover:bg-gray-700 transition-all flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Previous
            </button>
            <div class="text-gray-500 text-xs tracking-widest uppercase">
                Slide <span id="slide-num">1</span> / 6
            </div>
            <button id="next" class="nav-btn px-6 py-3 rounded-full bg-blue-600 text-sm font-bold hover:bg-blue-500 transition-all flex items-center gap-2">
                Next <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>
    </footer>

    <script>
        const slides = document.querySelectorAll('.slide');
        const nextBtn = document.getElementById('next');
        const prevBtn = document.getElementById('prev');
        const progress = document.getElementById('progress');
        const slideNumDisplay = document.getElementById('slide-num');
        
        let currentSlide = 0;

        function updateSlide() {
            slides.forEach((s, i) => {
                s.classList.remove('active');
                if(i === currentSlide) s.classList.add('active');
            });
            
            progress.style.width = `${((currentSlide + 1) / slides.length) * 100}%`;
            slideNumDisplay.innerText = currentSlide + 1;

            prevBtn.style.visibility = currentSlide === 0 ? 'hidden' : 'visible';
            nextBtn.innerText = currentSlide === slides.length - 1 ? 'Start Over' : 'Next';
            if (currentSlide === slides.length - 1) {
                nextBtn.innerHTML = 'Finish <i class="fa-solid fa-check"></i>';
            } else {
                nextBtn.innerHTML = 'Next <i class="fa-solid fa-arrow-right"></i>';
            }
        }

        nextBtn.addEventListener('click', () => {
            if(currentSlide < slides.length - 1) {
                currentSlide++;
            } else {
                currentSlide = 0;
            }
            updateSlide();
        });

        prevBtn.addEventListener('click', () => {
            if(currentSlide > 0) {
                currentSlide--;
                updateSlide();
            }
        });

        // Initialize
        updateSlide();

        // Keyboard support
        document.addEventListener('keydown', (e) => {
            if(e.key === 'ArrowRight') nextBtn.click();
            if(e.key === 'ArrowLeft') prevBtn.click();
        });
    </script>
</body>
</html>
